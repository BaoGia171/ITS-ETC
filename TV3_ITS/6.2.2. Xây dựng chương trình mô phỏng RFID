
import csv

# ==========================================
# 1. KHAI BAO FILE DU LIEU
# ==========================================

VEHICLE_FILE = "phuong_tien.csv"
TEST_FILE = "luot_xe.csv"
OUTPUT_FILE = "ket_qua_rfid.csv"

# Danh sach phuong tien
vehicles = {}

# Lich su nhan dien
history = []


# ==========================================
# 2. DOC DU LIEU TU FILE CSV
# ==========================================

def load_data():
    global vehicles

    # Doc danh sach phuong tien dang ky
    with open(VEHICLE_FILE, "r", encoding="utf-8-sig") as file:
        reader = csv.DictReader(file)

        for row in reader:
            ma_the = row["ma_the"].strip().upper()

            vehicles[ma_the] = {
                "ma_xe": row["ma_xe"].strip(),
                "bien_so": row["bien_so"].strip()
            }

    # Doc danh sach 12 luot xe thu nghiem
    with open(TEST_FILE, "r", encoding="utf-8-sig") as file:
        test_data = list(csv.DictReader(file))

    return test_data


# ==========================================
# 3. MO PHONG DOC THE RFID
# ==========================================

def read_rfid():
    tag_id = input("Nhap ma RFID: ").strip().upper()
    return tag_id


# ==========================================
# 4. KIEM TRA VA NHAN DIEN RFID
# ==========================================

def identify_vehicle(tag_id):
    print("\nDang tra cuu ma RFID...")

    # Truong hop khong doc duoc ma the
    if not tag_id:
        return {
            "ma_xe": "",
            "trang_thai": "CHUYEN_XAC_MINH",
            "ly_do": "Khong doc duoc ma RFID"
        }

    # Truong hop ma the khong ton tai
    if tag_id not in vehicles:
        return {
            "ma_xe": "",
            "trang_thai": "CHUYEN_XAC_MINH",
            "ly_do": "Ma RFID chua dang ky"
        }

    # Tra cuu thanh cong
    vehicle = vehicles[tag_id]

    return {
        "ma_xe": vehicle["ma_xe"],
        "trang_thai": "CHAP_NHAN",
        "ly_do": "Tim thay ma RFID trong danh sach dang ky"
    }


# ==========================================
# 5. CHAY MO PHONG TREN 12 LUOT XE
# ==========================================

def run_simulation(test_data):

    results = []

    print("\n========== MO PHONG NHAN DIEN RFID ==========")

    for item in test_data:

        ma_luot = item["ma_luot"]
        tag_id = item["rfid_nhan_duoc"].strip().upper()

        # Chi dua ma RFID vao ham nhan dien
        result = identify_vehicle(tag_id)

        # Doi chieu voi xe thuc te sau khi da nhan dien
        xe_thuc_te = item["xe_thuc_te"].strip()

        if result["trang_thai"] == "CHAP_NHAN":

            if result["ma_xe"] == xe_thuc_te:
                danh_gia = "DINH_DANH_DUNG_TU_DONG"
            else:
                danh_gia = "CHAP_NHAN_SAI"

        else:
            danh_gia = "CHUYEN_XAC_MINH"

        # Luu ket qua
        row = {
            "ma_luot": ma_luot,
            "ma_the_nhan_duoc": tag_id,
            "ma_xe": result["ma_xe"],
            "trang_thai": result["trang_thai"],
            "ly_do": result["ly_do"],
            "xe_thuc_te": xe_thuc_te,
            "ket_qua_danh_gia": danh_gia
        }

        results.append(row)
        history.append(row)

        print("------------------------------------------")
        print("Ma luot:", ma_luot)
        print("Ma RFID nhan duoc:", tag_id if tag_id else "Khong doc duoc")
        print("Ma xe nhan dien:", result["ma_xe"] if result["ma_xe"] else "Khong co")
        print("Trang thai:", result["trang_thai"])
        print("Ly do:", result["ly_do"])
        print("Danh gia:", danh_gia)

    return results


# ==========================================
# 6. XUAT KET QUA RA FILE CSV
# ==========================================

def export_results(results):

    fieldnames = [
        "ma_luot",
        "ma_the_nhan_duoc",
        "ma_xe",
        "trang_thai",
        "ly_do",
        "xe_thuc_te",
        "ket_qua_danh_gia"
    ]

    with open(OUTPUT_FILE, "w", newline="", encoding="utf-8-sig") as file:
        writer = csv.DictWriter(file, fieldnames=fieldnames)

        writer.writeheader()
        writer.writerows(results)

    print("\nDa xuat ket qua vao file:", OUTPUT_FILE)


# ==========================================
# 7. HIEN THI DANH SACH PHUONG TIEN
# ==========================================

def display_vehicles():

    print("\n========== DANH SACH PHUONG TIEN ==========")

    for ma_the, vehicle in vehicles.items():

        print("------------------------------------------")
        print("Ma xe:", vehicle["ma_xe"])
        print("Ma the RFID:", ma_the)
        print("Bien so:", vehicle["bien_so"])


# ==========================================
# 8. HIEN THI LICH SU NHAN DIEN
# ==========================================

def display_history():

    print("\n========== LICH SU NHAN DIEN ==========")

    if len(history) == 0:
        print("Chua co du lieu nhan dien.")
        return

    for item in history:

        print("------------------------------------------")
        print("Ma luot:", item["ma_luot"])
        print("Ma RFID:", item["ma_the_nhan_duoc"])
        print("Ma xe:", item["ma_xe"])
        print("Trang thai:", item["trang_thai"])
        print("Ket qua:", item["ket_qua_danh_gia"])


# ==========================================
# 9. THONG KE KET QUA
# ==========================================

def display_statistics(results):

    dung = 0
    sai = 0
    xac_minh = 0

    for item in results:

        if item["ket_qua_danh_gia"] == "DINH_DANH_DUNG_TU_DONG":
            dung += 1

        elif item["ket_qua_danh_gia"] == "CHAP_NHAN_SAI":
            sai += 1

        else:
            xac_minh += 1

    total = len(results)

    print("\n========== THONG KE KET QUA RFID ==========")
    print("Tong so luot:", total)
    print("Dinh danh dung tu dong:", dung)
    print("Chap nhan sai:", sai)
    print("Chuyen xac minh:", xac_minh)

    if total > 0:
        print("Ty le dinh danh dung: {:.2f}%".format(dung / total * 100))
        print("Ty le chap nhan sai: {:.2f}%".format(sai / total * 100))
        print("Ty le chuyen xac minh: {:.2f}%".format(xac_minh / total * 100))


# ==========================================
# 10. CHUONG TRINH CHINH
# ==========================================

def main():

    try:
        test_data = load_data()

    except FileNotFoundError as error:
        print("Khong tim thay file du lieu:", error.filename)
        print("Hay kiem tra lai vi tri cac file CSV.")
        return

    results = []

    while True:

        print("\n====================================")
        print("       HE THONG MO PHONG RFID")
        print("====================================")
        print("1. Chay mo phong 12 luot xe")
        print("2. Xem danh sach phuong tien")
        print("3. Xem lich su nhan dien")
        print("4. Thong ke ket qua")
        print("5. Thoat chuong trinh")

        choice = input("Chon chuc nang: ")

        if choice == "1":
            history.clear()
            results = run_simulation(test_data)
            export_results(results)

        elif choice == "2":
            display_vehicles()

        elif choice == "3":
            display_history()

        elif choice == "4":
            if len(results) == 0:
                print("Hay chay mo phong truoc.")
            else:
                display_statistics(results)

        elif choice == "5":
            print("Ket thuc chuong trinh RFID.")
            break

        else:
            print("Lua chon khong hop le!")


# ==========================================
# CHAY CHUONG TRINH
# ==========================================

if __name__ == "__main__":
    main()
