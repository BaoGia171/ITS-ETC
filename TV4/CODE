
import csv
import os

# =====================================================
# PHAN 6.4 - MO PHONG PHOI HOP RFID VA ANPR/LPR
# Thanh vien: VAN NGO HOANG PHUC (TV4)
# =====================================================

# 1. CAU HINH
FILE_RFID = "ket_qua_rfid.csv"
FILE_ANPR = "ket_qua_anpr.csv"
FILE_OUTPUT = "ket_qua_6_4.csv"

# Bo du lieu chung cua nhom: 12 luot xe
DANH_SACH_LUOT = [
    f"L{i:02d}" for i in range(1, 13)
]

# Cac trang thai duoc chap nhan la nhan dien thanh cong.
# TV1 va TV3 can thong nhat dung mot trong cac gia tri nay.
TRANG_THAI_THANH_CONG = {
    "THANH_CONG",
    "SUCCESS",
    "OK"
}


# 2. DOC FILE KET QUA TU 6.2 VA 6.3
def doc_du_lieu(ten_file):

    if not os.path.exists(ten_file):
        raise FileNotFoundError(
            f"Khong tim thay file: {ten_file}"
        )

    bang_du_lieu = {}

    with open(
        ten_file,
        "r",
        encoding="utf-8-sig",
        newline=""
    ) as file:

        reader = csv.DictReader(file)

        cot_bat_buoc = {
            "ma_luot",
            "ma_xe",
            "trang_thai"
        }

        if not reader.fieldnames or not cot_bat_buoc.issubset(
            set(reader.fieldnames)
        ):
            raise ValueError(
                f"{ten_file} phai co cac cot: "
                "ma_luot, ma_xe, trang_thai"
            )

        for dong in reader:

            ma_luot = (dong.get("ma_luot") or "").strip()

            if not ma_luot:
                continue

            if ma_luot in bang_du_lieu:
                raise ValueError(
                    f"Bi trung ma_luot {ma_luot} trong {ten_file}"
                )

            bang_du_lieu[ma_luot] = {
                "ma_xe": (dong.get("ma_xe") or "").strip(),
                "trang_thai": (
                    dong.get("trang_thai") or ""
                ).strip().upper()
            }

    return bang_du_lieu


# 3. KIEM TRA KET QUA NHAN DIEN CUA MOT NGUON
def nhan_dien_thanh_cong(du_lieu):

    if du_lieu is None:
        return False

    ma_xe = du_lieu["ma_xe"]
    trang_thai = du_lieu["trang_thai"]

    return (
        ma_xe != ""
        and trang_thai in TRANG_THAI_THANH_CONG
    )


# 4. HAM PHOI HOP HAI NGUON
def doi_chieu_hai_nguon(bang_rfid, bang_anpr):

    ket_qua = []

    for ma_luot in DANH_SACH_LUOT:

        rfid = bang_rfid.get(ma_luot)
        anpr = bang_anpr.get(ma_luot)

        ma_xe_rfid = (
            rfid["ma_xe"] if rfid else ""
        )

        ma_xe_anpr = (
            anpr["ma_xe"] if anpr else ""
        )

        # Mac dinh chuyen xac minh
        trang_thai = "CAN_XAC_MINH"
        ma_xe_ket_qua = ""
        ket_luan = "Chuyen xac minh thu cong"

        # Truong hop thieu du lieu
        if rfid is None and anpr is None:

            trang_thai = "THIEU_CA_HAI_NGUON"

        elif rfid is None:

            trang_thai = "THIEU_RFID"

        elif anpr is None:

            trang_thai = "THIEU_ANPR"

        # Hai nguon deu co du lieu
        else:

            rfid_ok = nhan_dien_thanh_cong(rfid)
            anpr_ok = nhan_dien_thanh_cong(anpr)

            if not rfid_ok and not anpr_ok:

                trang_thai = "CA_HAI_NHAN_DIEN_THAT_BAI"

            elif not rfid_ok:

                trang_thai = "RFID_NHAN_DIEN_THAT_BAI"

            elif not anpr_ok:

                trang_thai = "ANPR_NHAN_DIEN_THAT_BAI"

            # Chi chap nhan khi hai ma xe giong nhau
            elif ma_xe_rfid == ma_xe_anpr:

                trang_thai = "KHOP"
                ma_xe_ket_qua = ma_xe_rfid
                ket_luan = "CHAP NHAN DINH DANH TU DONG"

            else:

                trang_thai = "KHONG_KHOP"

        # Luu ket qua
        ket_qua.append({
            "ma_luot": ma_luot,
            "ma_xe_rfid": ma_xe_rfid,
            "ma_xe_anpr": ma_xe_anpr,
            "trang_thai_phoi_hop": trang_thai,
            "ma_xe_ket_qua": ma_xe_ket_qua,
            "ket_luan": ket_luan
        })

    return ket_qua


# 5. HIEN THI BANG KET QUA
def hien_thi_ket_qua(ket_qua):

    print("\n" + "=" * 115)
    print("MO PHONG PHOI HOP HAI NGUON RFID VA ANPR/LPR")
    print("PHAN 6.4 - THANH VIEN VAN NGO HOANG PHUC")
    print("=" * 115)

    print(
        f"{'MA LUOT':<10}"
        f"{'MA XE RFID':<15}"
        f"{'MA XE ANPR':<15}"
        f"{'TRANG THAI':<32}"
        f"{'MA XE KET QUA':<18}"
        f"KET LUAN"
    )

    print("-" * 115)

    for dong in ket_qua:

        print(
            f"{dong['ma_luot']:<10}"
            f"{dong['ma_xe_rfid'] or 'Khong co':<15}"
            f"{dong['ma_xe_anpr'] or 'Khong co':<15}"
            f"{dong['trang_thai_phoi_hop']:<32}"
            f"{dong['ma_xe_ket_qua'] or 'Trong':<18}"
            f"{dong['ket_luan']}"
        )

    print("=" * 115)


# 6. THONG KE KET QUA
def thong_ke(ket_qua):

    tong = len(ket_qua)

    so_khop = sum(
        1 for dong in ket_qua
        if dong["trang_thai_phoi_hop"] == "KHOP"
    )

    so_xac_minh = tong - so_khop

    print("\nTHONG KE KET QUA")
    print("-" * 40)

    print("Tong so luot xe:", tong)
    print("So luot hai nguon khop:", so_khop)
    print("So luot can xac minh:", so_xac_minh)

    if tong > 0:
        ty_le = so_khop / tong * 100

        print(
            f"Ty le khop hai nguon: {ty_le:.2f}%"
        )


# 7. XUAT FILE KET QUA CHO TV5
def xuat_csv(ket_qua):

    ten_cot = [
        "ma_luot",
        "ma_xe_rfid",
        "ma_xe_anpr",
        "trang_thai_phoi_hop",
        "ma_xe_ket_qua",
        "ket_luan"
    ]

    with open(
        FILE_OUTPUT,
        "w",
        encoding="utf-8-sig",
        newline=""
    ) as file:

        writer = csv.DictWriter(
            file,
            fieldnames=ten_cot
        )

        writer.writeheader()
        writer.writerows(ket_qua)

    print(
        f"\nDa xuat ket qua thanh cong: {FILE_OUTPUT}"
    )


# 8. CHUONG TRINH CHINH
def main():

    try:

        print("DANG DOC DU LIEU TU 6.2 VA 6.3...")

        bang_rfid = doc_du_lieu(FILE_RFID)
        bang_anpr = doc_du_lieu(FILE_ANPR)

        # Kiem tra ma luot ngoai bo du lieu chung
        for ten_nguon, bang in [
            ("RFID", bang_rfid),
            ("ANPR", bang_anpr)
        ]:
            ma_ngoai = set(bang.keys()) - set(DANH_SACH_LUOT)

            if ma_ngoai:
                raise ValueError(
                    f"Nguon {ten_nguon} co ma_luot "
                    f"khong thuoc L01-L12: {sorted(ma_ngoai)}"
                )

        print("Da doc du lieu thanh cong.")

        print(
            "So luot RFID:",
            len(bang_rfid)
        )

        print(
            "So luot ANPR:",
            len(bang_anpr)
        )

        # Doi chieu hai nguon
        ket_qua = doi_chieu_hai_nguon(
            bang_rfid,
            bang_anpr
        )

        # Hien thi ket qua
        hien_thi_ket_qua(ket_qua)

        # Thong ke
        thong_ke(ket_qua)

        # Xuat ket qua cho TV5
        xuat_csv(ket_qua)

    except (FileNotFoundError, ValueError) as loi:

        print("\nLOI:", loi)

    except Exception as loi:

        print("\nLOI KHONG XAC DINH:", loi)


# 9. CHAY CHUONG TRINH
if __name__ == "__main__":
    main()
